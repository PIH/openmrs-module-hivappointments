<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans
  		    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<bean id="hivAppointmentsConfig" class="org.openmrs.module.hivappointments.HivAppointmentsConfig">
		<property name="administrationService" ref="adminService"/>
		<property name="conceptService" ref="conceptService"/>
		<property name="encounterService" ref="encounterService"/>
		<property name="programWorkflowService" ref="programWorkflowService"/>
		<property name="personService" ref="personService"/>
		<property name="patientService" ref="patientService"/>
	</bean>

	<bean id="hivAppointmentsService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="transactionManager" ref="transactionManager"/>
		<property name="target">
			<bean class="org.openmrs.module.hivappointments.HivAppointmentsServiceImpl">
				<property name="config" ref="hivAppointmentsConfig"/>
				<property name="sessionFactory" ref="dbSessionFactory"/>
				<property name="patientService" ref="patientService"/>
				<property name="encounterService" ref="encounterService"/>
				<property name="locationService" ref="locationService"/>
				<property name="obsService" ref="obsService"/>
				<property name="providerService" ref="providerService"/>
			</bean>
		</property>
		<property name="preInterceptors" ref="serviceInterceptors"/>
		<property name="transactionAttributeSource">
			<bean class="org.springframework.transaction.annotation.AnnotationTransactionAttributeSource"/>
		</property>
	</bean>

	<bean parent="serviceContext">
		<property name="moduleService">
			<list merge="true">
				<value>org.openmrs.module.hivappointments.HivAppointmentsService</value>
				<ref bean="hivAppointmentsService"/>
			</list>
		</property>
	</bean>

</beans>
